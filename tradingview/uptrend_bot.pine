//@version=5
// =============================================================================
//  Uptrend Swing Bot  —  for the 1-hour chart (works on XRP/USD, BTC/USD, ...)
// -----------------------------------------------------------------------------
//  Load it on XRP/USD (Coinbase) 1h AND on BTC/USD (Coinbase) 1h - same script,
//  just add it to each chart. It adapts to whatever symbol it's on.
//
//  Your strategy, exactly:
//    * Longs only.
//    * Trade an INTACT UPTREND: higher highs forming + higher lows forming
//      + price above the 20 EMA.
//    * STOP just below the most recent higher low (if it breaks, the trend
//      you're trading may be ending).
//    * TAKE PROFIT at 2x the risk distance (1:2 reward).
//    * Position sized to risk a chosen % of equity, but NEVER more than the
//      account holds  ->  spot, no leverage, so the account CANNOT go negative.
//
//  How to use:
//    1. Open XRP/USD on Coinbase in TradingView, set timeframe to 1h.
//    2. Pine Editor -> paste this -> "Add to chart".
//    3. Open the "Strategy Tester" tab to see the backtest on real 1h data.
//    4. Tune the inputs (EMA, pivot strength, R:R, risk %) and watch Net Profit,
//       % Profitable, Profit Factor, and Max Drawdown.
//    5. Create an Alert on "XRP Uptrend Swing Bot" -> "alert() function calls"
//       to paper-trade / later fire a webhook to a broker.
// =============================================================================
strategy("Uptrend Swing Bot",
     overlay              = true,
     initial_capital      = 50,
     currency             = currency.USD,
     default_qty_type     = strategy.fixed,
     commission_type      = strategy.commission.percent,
     commission_value     = 0.05,
     pyramiding           = 0,
     calc_on_every_tick   = false,
     process_orders_on_close = false)

// ---------------------------------------------------------------- Inputs ----
emaLen   = input.int(20,   "Trend EMA length", minval = 1, group = "Trend")
pivLeft  = input.int(3,    "Swing strength (left bars)",  minval = 1, group = "Swings")
pivRight = input.int(3,    "Swing strength (right bars)", minval = 1, group = "Swings")
rr       = input.float(2.0,"Reward : Risk (take-profit multiple)", minval = 0.5, step = 0.5, group = "Exits")
bufPct   = input.float(0.1,"Stop buffer below higher low (%)", minval = 0.0, step = 0.1, group = "Exits") / 100.0
riskPct  = input.float(3.0,"Risk per trade (% of equity)", minval = 0.1, maxval = 100, step = 0.5, group = "Sizing") / 100.0

// ------------------------------------------------------------- Indicators ---
ema = ta.ema(close, emaLen)

// Confirmed swing pivots (ta.pivot* already looks back `pivRight` bars, so the
// value only appears once the pivot is confirmed -> no lookahead).
ph = ta.pivothigh(high, pivLeft, pivRight)
pl = ta.pivotlow(low,  pivLeft, pivRight)

var float lastPH = na
var float prevPH = na
var float lastPL = na
var float prevPL = na
if not na(ph)
    prevPH := lastPH
    lastPH := ph
if not na(pl)
    prevPL := lastPL
    lastPL := pl

// ----------------------------------------------------------- Trend logic ----
higherHighs = not na(lastPH) and not na(prevPH) and lastPH > prevPH
higherLows  = not na(lastPL) and not na(prevPL) and lastPL > prevPL
uptrend     = higherHighs and higherLows and close > ema

// ---------------------------------------------------------- Risk & sizing ---
stopPrice    = na(lastPL) ? na : lastPL * (1.0 - bufPct)
riskPerUnit  = close - stopPrice                 // distance to the stop
takeProfit   = close + rr * riskPerUnit

// Size by risk, but cap notional at equity (spot, no leverage -> never negative)
riskQty = riskPerUnit > 0 ? (strategy.equity * riskPct) / riskPerUnit : 0.0
maxQty  = strategy.equity / close
qty     = math.min(riskQty, maxQty)

canEnter = uptrend and strategy.position_size == 0 and riskPerUnit > 0 and qty > 0

// -------------------------------------------------------------- Orders ------
if canEnter
    strategy.entry("Long", strategy.long, qty = qty)
    alert(syminfo.ticker + " BUY: entry ~" + str.tostring(close) + " stop " + str.tostring(stopPrice) + " target " + str.tostring(takeProfit), alert.freq_once_per_bar)

if strategy.position_size > 0
    strategy.exit("Exit", from_entry = "Long", stop = stopPrice, limit = takeProfit)

// ---------------------------------------------------------------- Plots -----
plot(ema, "20 EMA", color = color.orange)
plot(strategy.position_size > 0 ? stopPrice   : na, "Stop",   color = color.red,   style = plot.style_linebr)
plot(strategy.position_size > 0 ? takeProfit  : na, "Target", color = color.green, style = plot.style_linebr)
plotshape(canEnter, "Entry", shape.triangleup, location.belowbar, color.new(color.green, 0), size = size.tiny)
